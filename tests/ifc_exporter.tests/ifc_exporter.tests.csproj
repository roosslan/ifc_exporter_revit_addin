<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Директория со сборкой надстройки для Revit 2026 (net8); переопределяется через -p:AddinDir=... -->
    <AddinDir Condition="'$(AddinDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\build\revit2026\</AddinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестируются только классы без зависимостей от Revit API, поэтому RevitAPI.dll не нужна -->
    <Reference Include="ifc_exporter">
      <HintPath>$(AddinDir)ifc_exporter.dll</HintPath>
    </Reference>
    <!-- Без Ijwhost.dll смешанная сборка C++/CLI не загружается -->
    <None Include="$(AddinDir)Ijwhost.dll" Link="Ijwhost.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
